# Local testing only (docker compose on the Mac). Copy to .env, which is
# gitignored, and fill in. The cluster's values are separate: they live in the
# k8s repo as a SOPS-encrypted allsky/*-secret.yaml.
MARIADB_DATABASE=indi_allsky
MARIADB_USER=indi_allsky_own
MARIADB_PASSWORD=
INDIALLSKY_MARIADB_HOST=db
INDIALLSKY_MARIADB_PORT=3306
INDIALLSKY_MARIADB_SSL=false
INDIALLSKY_MARIADB_CHARSET=utf8mb4
INDIALLSKY_MARIADB_COLLATION=utf8mb4_unicode_ci

INDIALLSKY_IMAGE_FOLDER=/var/www/html/allsky/images
INDIALLSKY_FLASK_AUTH_ALL_VIEWS=false
# openssl rand -hex 32 for each
INDIALLSKY_FLASK_SECRET_KEY=
INDIALLSKY_FLASK_PASSWORD_KEY=

# First admin user, created on first start
INDIALLSKY_WEB_USER=admin
INDIALLSKY_WEB_PASS=
INDIALLSKY_WEB_NAME=Local Admin
INDIALLSKY_WEB_EMAIL=admin@example.local
INDIALLSKY_WEB_GENERATE_APIKEY=false

# Skip most of start_gunicorn.sh's 60 s wait for the DB (compose waits on its healthcheck)
INDIALLSKY_GUNICORN_NO_WAIT=1
